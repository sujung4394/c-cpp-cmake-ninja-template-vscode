{
    "tasks": [
        {
            "type": "shell",
            "label": "CMake 디버그 빌드",
            "command": "cmake --build ${workspaceFolder}\\build --config Debug",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build"
            }
        },
        {
            "type": "shell",
            "label": "CMake 빌드",
            "command": "cmake --build ${workspaceFolder}\\build --config Release",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "type": "process",
            "label": "C/C++ 파일 실행",
            "command": "${workspaceFolder}\\bin\\main.exe",
            "args": ["${input:programArgs}"],
            "group": {
                "kind": "test",
                "isDefault": true
            }
        }
    ],
    "inputs": [
        {
            "id": "programArgs",
            "type": "promptString",
            "description": "실행 인자 입력"
        }
    ],
    "version": "2.0.0"
}